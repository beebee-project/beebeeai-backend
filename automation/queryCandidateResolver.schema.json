{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beebeeai.kr/schemas/query-candidate-resolution-v1.json",
  "title": "BeeBee AI Deterministic Candidate Resolution v1",
  "type": "object",
  "required": [
    "version",
    "itemVersion",
    "policy",
    "source",
    "integrity",
    "counts",
    "candidates",
    "resolutionSha256"
  ],
  "properties": {
    "version": {
      "const": "query_candidate_resolution_v1"
    },
    "itemVersion": {
      "const": "query_candidate_resolution_item_v1"
    },
    "policy": {
      "type": "object",
      "required": [
        "version",
        "priorRetrievedCarriedAsResolved",
        "priorExcludedAreTerminal",
        "onlyDeferredCandidatesAreSemanticallyReassessed",
        "unboundCandidatesRemainDeferred",
        "inferredFailureIsConservative",
        "genericExecutorMayResolveSemantics",
        "strongCandidateIdentityOverridesDynamicRecipeTokens",
        "semanticSecondaryDomainEvidenceAllowed",
        "inferredNamedTemplatesRequireIdentityEvidence",
        "inferredAggregateRecipeOperandsRequireColumnBinding",
        "operandSpecificColumnEvidenceRequired",
        "finalReadyStatusAssigned",
        "candidateStatusMutation"
      ],
      "properties": {
        "version": {
          "const": "deterministic_candidate_resolution_policy_v1_2"
        },
        "priorRetrievedCarriedAsResolved": {
          "const": true
        },
        "priorExcludedAreTerminal": {
          "const": true
        },
        "onlyDeferredCandidatesAreSemanticallyReassessed": {
          "const": true
        },
        "unboundCandidatesRemainDeferred": {
          "const": true
        },
        "inferredFailureIsConservative": {
          "const": true
        },
        "genericExecutorMayResolveSemantics": {
          "const": true
        },
        "finalReadyStatusAssigned": {
          "const": false
        },
        "candidateStatusMutation": {
          "const": false
        },
        "strongCandidateIdentityOverridesDynamicRecipeTokens": {
          "const": true
        },
        "semanticSecondaryDomainEvidenceAllowed": {
          "const": true
        },
        "inferredNamedTemplatesRequireIdentityEvidence": {
          "const": true
        },
        "inferredAggregateRecipeOperandsRequireColumnBinding": {
          "const": true
        },
        "operandSpecificColumnEvidenceRequired": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "caseId",
        "fileName",
        "retrievalVersion",
        "retrievalSha256",
        "capabilityManifestVersion",
        "capabilityManifestSha256",
        "resolvedSemanticProfileVersion",
        "resolvedSemanticProfileSha256",
        "deterministicSemanticProfileSha256",
        "primaryDomain",
        "datasetIntent",
        "domainConfidence"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "retrievalCandidateCount",
        "capabilityCandidateCount",
        "missingCapabilityCandidateIds",
        "orphanCapabilityCandidateIds",
        "candidateCountMatch",
        "retrievalCapabilityHashMatch",
        "retrievalDeterministicProfileHashMatch"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "total",
        "resolved",
        "stillDeferred",
        "excluded",
        "carriedResolved",
        "semanticResolved",
        "carriedExcluded",
        "newlyExcluded",
        "inferredResolved",
        "unboundStillDeferred",
        "sourceAmbiguous"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "stillDeferred": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "carriedResolved": {
          "type": "integer",
          "minimum": 0
        },
        "semanticResolved": {
          "type": "integer",
          "minimum": 0
        },
        "carriedExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "newlyExcluded": {
          "type": "integer",
          "minimum": 0
        },
        "inferredResolved": {
          "type": "integer",
          "minimum": 0
        },
        "unboundStillDeferred": {
          "type": "integer",
          "minimum": 0
        },
        "sourceAmbiguous": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "resolutionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checkStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "reason": {
      "type": "object",
      "required": [
        "code",
        "level",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKING"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "version",
        "candidateId",
        "recipeId",
        "templateId",
        "candidateType",
        "result",
        "previousRetrievalResult",
        "bindingStatus",
        "bindingSource",
        "originalRank",
        "originalScore",
        "resolutionScore",
        "sourceTableIds",
        "matchedTableIds",
        "matchedPhysicalTableIds",
        "matchedColumnIds",
        "checks",
        "reasons",
        "missingRequirements",
        "evidence",
        "provenance",
        "resolutionItemSha256"
      ],
      "properties": {
        "version": {
          "const": "query_candidate_resolution_item_v1"
        },
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "recipeId": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "candidateType": {
          "type": "string"
        },
        "result": {
          "enum": [
            "RESOLVED",
            "STILL_DEFERRED",
            "EXCLUDED"
          ]
        },
        "previousRetrievalResult": {
          "enum": [
            "RETRIEVED",
            "DEFERRED",
            "EXCLUDED"
          ]
        },
        "bindingStatus": {
          "enum": [
            "BOUND",
            "PARTIAL",
            "INFERRED",
            "UNBOUND"
          ]
        },
        "bindingSource": {
          "type": "string"
        },
        "originalRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "originalScore": {
          "type": [
            "number",
            "null"
          ]
        },
        "resolutionScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sourceTableIds": {
          "$ref": "#/$defs/stringArray"
        },
        "matchedTableIds": {
          "$ref": "#/$defs/stringArray"
        },
        "matchedPhysicalTableIds": {
          "$ref": "#/$defs/stringArray"
        },
        "matchedColumnIds": {
          "$ref": "#/$defs/stringArray"
        },
        "checks": {
          "type": "object",
          "required": [
            "sourceScope",
            "domainAlignment",
            "executorSupport",
            "operandBinding",
            "requiredRoles",
            "requiredCapabilities",
            "metricFamily",
            "constraints"
          ],
          "properties": {
            "sourceScope": {
              "type": "object"
            },
            "domainAlignment": {
              "type": "object"
            },
            "executorSupport": {
              "type": "object"
            },
            "operandBinding": {
              "type": "object",
              "required": [
                "status",
                "operation",
                "identifier",
                "operands",
                "matchedColumnIds",
                "reasonCode"
              ],
              "properties": {
                "status": {
                  "$ref": "#/$defs/checkStatus"
                },
                "operation": {
                  "type": "string"
                },
                "identifier": {
                  "type": "string"
                },
                "operands": {
                  "type": "array"
                },
                "matchedColumnIds": {
                  "$ref": "#/$defs/stringArray"
                },
                "reasonCode": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "requiredRoles": {
              "type": "array"
            },
            "requiredCapabilities": {
              "type": "array"
            },
            "metricFamily": {
              "type": "object"
            },
            "constraints": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "missingRequirements": {
          "type": "array"
        },
        "evidence": {
          "type": "array"
        },
        "provenance": {
          "type": "object",
          "required": [
            "retrievalItemVersion",
            "retrievalItemSha256",
            "candidateStatus",
            "terminalPriorResult",
            "semanticReassessmentPerformed"
          ]
        },
        "resolutionItemSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
