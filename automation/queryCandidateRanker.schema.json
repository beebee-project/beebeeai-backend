{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "queryCandidateRanker.schema.json",
  "title": "Query Candidate Ranking Resolution",
  "type": "object",
  "required": [
    "version",
    "itemVersion",
    "policy",
    "source",
    "integrity",
    "counts",
    "rankedCandidateIds",
    "recommendedCandidateIds",
    "candidates",
    "rankingResolutionSha256"
  ],
  "properties": {
    "version": {
      "const": "query_candidate_ranking_resolution_v1"
    },
    "itemVersion": {
      "const": "query_candidate_ranking_item_v1"
    },
    "policy": {
      "type": "object",
      "required": [
        "version",
        "readyCandidatesOnly",
        "feasibilityRequired",
        "reviewCandidatesExcluded",
        "unsupportedCandidatesExcluded",
        "allReadyCandidatesRanked",
        "fixedScoreWeights",
        "deterministicDiversityReranking",
        "metricAggregationAffinityEnabled",
        "degenerateGroupPenaltyEnabled",
        "semanticProfileStatsAreSignalsNotGates",
        "primaryLimit",
        "recommendedLimit",
        "priorScoresAreSignalsNotGates",
        "sourceCandidatesAreNotRemovedOrMutated",
        "feasibilityStatusMutation",
        "productionRouteChanged"
      ],
      "properties": {
        "version": {
          "const": "deterministic_candidate_ranking_policy_v1_1"
        },
        "readyCandidatesOnly": {
          "const": true
        },
        "feasibilityRequired": {
          "const": true
        },
        "reviewCandidatesExcluded": {
          "const": true
        },
        "unsupportedCandidatesExcluded": {
          "const": true
        },
        "allReadyCandidatesRanked": {
          "const": true
        },
        "fixedScoreWeights": {
          "const": true
        },
        "deterministicDiversityReranking": {
          "const": true
        },
        "metricAggregationAffinityEnabled": {
          "const": true
        },
        "degenerateGroupPenaltyEnabled": {
          "const": true
        },
        "semanticProfileStatsAreSignalsNotGates": {
          "const": true
        },
        "primaryLimit": {
          "const": 3
        },
        "recommendedLimit": {
          "const": 8
        },
        "priorScoresAreSignalsNotGates": {
          "const": true
        },
        "sourceCandidatesAreNotRemovedOrMutated": {
          "const": true
        },
        "feasibilityStatusMutation": {
          "const": false
        },
        "productionRouteChanged": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "required": [
        "sourceCandidateCount",
        "familyCandidateCount",
        "feasibilityCandidateCount",
        "readyFeasibilityCount",
        "candidateCoverageComplete",
        "readyCoverageComplete",
        "rankSequenceContiguous",
        "rankedCandidateIdsUnique",
        "recommendedPrefixComplete",
        "sourceCandidatesPreserved",
        "rankingContainsNoSourceRecords"
      ],
      "properties": {
        "sourceCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "familyCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "feasibilityCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "readyFeasibilityCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateCoverageComplete": {
          "const": true
        },
        "readyCoverageComplete": {
          "const": true
        },
        "rankSequenceContiguous": {
          "const": true
        },
        "rankedCandidateIdsUnique": {
          "const": true
        },
        "recommendedPrefixComplete": {
          "const": true
        },
        "sourceCandidatesPreserved": {
          "const": true
        },
        "rankingContainsNoSourceRecords": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "total",
        "readyInput",
        "ranked",
        "notApplicable",
        "primary",
        "secondary",
        "additional",
        "recommended"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "readyInput": {
          "type": "integer",
          "minimum": 0
        },
        "ranked": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "primary": {
          "type": "integer",
          "minimum": 0
        },
        "secondary": {
          "type": "integer",
          "minimum": 0
        },
        "additional": {
          "type": "integer",
          "minimum": 0
        },
        "recommended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "rankedCandidateIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "recommendedCandidateIds": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "candidateId",
          "familyId",
          "feasibilityStatus",
          "rankingDisposition",
          "rank",
          "rankingTier",
          "rankingScore",
          "baseScore",
          "diversityPenalty",
          "scoreComponents",
          "operation",
          "operationCategory",
          "sourceTableIds",
          "recipeId",
          "templateId",
          "reasonCode",
          "provenance"
        ],
        "properties": {
          "version": {
            "const": "query_candidate_ranking_item_v1"
          },
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "familyId": {
            "type": "string"
          },
          "feasibilityStatus": {
            "enum": [
              "READY",
              "REVIEW",
              "UNSUPPORTED",
              "NOT_APPLICABLE",
              ""
            ]
          },
          "rankingDisposition": {
            "enum": [
              "RANKED",
              "NOT_APPLICABLE"
            ]
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "rankingTier": {
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "ADDITIONAL",
              "NOT_APPLICABLE"
            ]
          },
          "rankingScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "baseScore": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "diversityPenalty": {
            "type": [
              "object",
              "null"
            ]
          },
          "scoreComponents": {
            "type": "object"
          },
          "operation": {
            "type": "string"
          },
          "operationCategory": {
            "type": "string"
          },
          "sourceTableIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "recipeId": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "required": [
              "feasibilityItemVersion",
              "feasibilityItemSha256",
              "familyMemberVersion",
              "familyMemberSha256",
              "resolutionItemVersion",
              "resolutionItemSha256",
              "sourceCandidateUnmodified",
              "feasibilityStatusMutated",
              "productionRouteChanged"
            ],
            "properties": {
              "feasibilityItemVersion": {
                "type": "string"
              },
              "feasibilityItemSha256": {
                "type": "string"
              },
              "familyMemberVersion": {
                "type": "string"
              },
              "familyMemberSha256": {
                "type": "string"
              },
              "resolutionItemVersion": {
                "type": "string"
              },
              "resolutionItemSha256": {
                "type": "string"
              },
              "sourceCandidateUnmodified": {
                "const": true
              },
              "feasibilityStatusMutated": {
                "const": false
              },
              "productionRouteChanged": {
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "rankingResolutionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
