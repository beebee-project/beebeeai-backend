{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beebeeai.kr/schemas/llm-semantic-profile-v1.json",
  "title": "BeeBee AI Integrated LLM Semantic Profile v1",
  "type": "object",
  "required": [
    "version",
    "schemaVersion",
    "taxonomyVersion",
    "promptVersion",
    "source",
    "model",
    "privacy",
    "classification",
    "tableSemantics",
    "columnSemantics",
    "tableRelations",
    "ambiguities",
    "requiresHumanReview",
    "usage",
    "integrity",
    "profileSha256"
  ],
  "properties": {
    "version": { "const": "llm_semantic_profile_v1" },
    "schemaVersion": { "const": "query_semantic_profiler_schema_v1" },
    "taxonomyVersion": { "const": "query_semantic_profiler_taxonomy_v1" },
    "promptVersion": { "const": "query_semantic_profiler_prompt_v1" },
    "source": {
      "type": "object",
      "required": [
        "caseId",
        "fileName",
        "semanticProfileVersion",
        "semanticProfileSha256",
        "inputSha256"
      ],
      "properties": {
        "caseId": { "type": "string" },
        "fileName": { "type": "string" },
        "semanticProfileVersion": { "type": "string" },
        "semanticProfileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "model", "reasoningEffort", "responseId"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["none", "low", "medium", "high", "xhigh", "max"] },
        "responseId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "rawRowsSent",
        "sampleValuesSent",
        "originalFileSent",
        "fileNameSent",
        "includedTableCount",
        "includedColumnCount"
      ],
      "properties": {
        "rawRowsSent": { "const": false },
        "sampleValuesSent": { "const": false },
        "originalFileSent": { "const": false },
        "fileNameSent": { "const": false },
        "includedTableCount": { "type": "integer", "minimum": 0 },
        "includedColumnCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["primaryDomain", "secondaryDomains", "datasetIntent", "confidence", "description"],
      "properties": {
        "primaryDomain": { "$ref": "#/$defs/domain" },
        "secondaryDomains": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domain" }
        },
        "datasetIntent": { "$ref": "#/$defs/datasetIntent" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tableSemantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/tableSemantic" }
    },
    "columnSemantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/columnSemantic" }
    },
    "tableRelations": {
      "type": "array",
      "items": { "$ref": "#/$defs/tableRelation" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "requiresHumanReview": { "type": "boolean" },
    "usage": {
      "type": "object",
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteTokens",
        "outputTokens",
        "reasoningTokens",
        "totalTokens",
        "estimatedCostUsd"
      ],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "modelOutputSha256",
        "validationWarningCount",
        "inputTableCount",
        "inputColumnCount",
        "tableSemanticCount",
        "columnSemanticCount",
        "relationCount"
      ],
      "properties": {
        "modelOutputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validationWarningCount": { "type": "integer", "minimum": 0 },
        "inputTableCount": { "type": "integer", "minimum": 0 },
        "inputColumnCount": { "type": "integer", "minimum": 0 },
        "tableSemanticCount": { "type": "integer", "minimum": 0 },
        "columnSemanticCount": { "type": "integer", "minimum": 0 },
        "relationCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "profileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "domain": {
      "enum": [
        "SALES_REVENUE",
        "FINANCE_BUDGET",
        "EVENT_ATTENDANCE",
        "EDUCATION_EVALUATION",
        "HR_PEOPLE",
        "INVENTORY_LOGISTICS",
        "PROJECT_RESEARCH_ADMIN",
        "SURVEY_FEEDBACK",
        "CUSTOMER_VENDOR",
        "OPERATIONS_GENERAL",
        "UNKNOWN"
      ]
    },
    "datasetIntent": {
      "enum": [
        "TRANSACTION_ANALYSIS",
        "BUDGET_EXECUTION",
        "ATTENDANCE_TRACKING",
        "APPLICATION_TRACKING",
        "PERFORMANCE_EVALUATION",
        "SURVEY_ANALYSIS",
        "INVENTORY_TRACKING",
        "ROSTER_MANAGEMENT",
        "STATUS_TRACKING",
        "TIME_TREND",
        "RANKING_COMPARISON",
        "AGGREGATE_SUMMARY",
        "GENERAL_TABULAR_RECORDS",
        "UNKNOWN"
      ]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tableSemantic": {
      "type": "object",
      "required": ["tableId", "tablePurpose", "rowGrain", "confidence", "evidenceCodes", "description"],
      "properties": {
        "tableId": { "type": "string" },
        "tablePurpose": { "type": "string" },
        "rowGrain": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCodes": { "$ref": "#/$defs/stringArray" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "columnSemantic": {
      "type": "object",
      "required": [
        "tableId",
        "columnId",
        "normalizedMeaning",
        "semanticRole",
        "semanticType",
        "metricFamily",
        "defaultAggregation",
        "unitSemantic",
        "decision",
        "confidence",
        "evidenceCodes",
        "description"
      ],
      "properties": {
        "tableId": { "type": "string" },
        "columnId": { "type": "string" },
        "normalizedMeaning": { "type": "string" },
        "semanticRole": { "type": "string" },
        "semanticType": { "type": "string" },
        "metricFamily": { "type": "string" },
        "defaultAggregation": { "type": "string" },
        "unitSemantic": { "type": "string" },
        "decision": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCodes": { "$ref": "#/$defs/stringArray" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tableRelation": {
      "type": "object",
      "required": [
        "leftTableId",
        "rightTableId",
        "relationType",
        "cardinality",
        "leftColumnIds",
        "rightColumnIds",
        "confidence",
        "evidenceCodes",
        "description"
      ],
      "properties": {
        "leftTableId": { "type": "string" },
        "rightTableId": { "type": "string" },
        "relationType": { "type": "string" },
        "cardinality": { "type": "string" },
        "leftColumnIds": { "$ref": "#/$defs/stringArray" },
        "rightColumnIds": { "$ref": "#/$defs/stringArray" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceCodes": { "$ref": "#/$defs/stringArray" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ambiguity": {
      "type": "object",
      "required": ["code", "description", "tableIds", "columnIds"],
      "properties": {
        "code": { "type": "string" },
        "description": { "type": "string" },
        "tableIds": { "$ref": "#/$defs/stringArray" },
        "columnIds": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    }
  }
}
