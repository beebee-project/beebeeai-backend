+      const score = semanticMetricCompatibilityScore({
+        requestedLabel: label,
+        candidateMetric,
+      });
+      if (score > bestScore) {
+        bestScore = score;
+        bestIndex = index;
+      }
+    });
+  }
+
+  return bestScore >= 10 ? bestIndex : -1;
+}
